{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "require-sri": "off",
    "element-required-attributes": "warn",
    "valid-id": "error",
    "void-style": "off",
    "doctype-style": "off",
    "no-raw-characters": "off",
    "hidden-focusable": "off",
    "heading-level": "warn",
    "no-trailing-whitespace": "off"
  }
}
